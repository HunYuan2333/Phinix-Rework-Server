<Project>
  <!-- SDK projects acquire reference assemblies automatically; classic client projects do not.
       Restore the compile-only targeting pack so they also build with dotnet MSBuild on Linux. -->
  <ItemGroup Condition="'$(UsingMicrosoftNETSdk)' != 'true' and '$(TargetFrameworkVersion)' == 'v4.7.2'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Keep protobuf SDK compatibility patches in the main repo instead of modifying the vendored submodule. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Google.Protobuf'">
    <NoWarn>$(NoWarn);NETSDK1215</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Google.Protobuf' and '$(TargetFramework)' != 'net50'">
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <!-- The upstream netstandard1.1 restore pulls vulnerable framework support packages.
       Override only this server build's legacy target; retain the source/gitlink/SDK pins. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Google.Protobuf' and '$(TargetFramework)' == 'netstandard1.1'">
    <PackageReference Include="System.Net.Http" Version="[4.3.4]" PrivateAssets="all" />
    <PackageReference Include="System.Text.RegularExpressions" Version="[4.3.1]" PrivateAssets="all" />
  </ItemGroup>
</Project>
