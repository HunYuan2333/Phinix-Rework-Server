<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{91DAC5B9-03E6-45DA-A0FD-AAA805ED131D}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>PhinixServer</RootNamespace>
    <AssemblyName>PhinixServer</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Command.cs" />
    <Compile Include="CommandInterpreter.cs" />
    <Compile Include="Config.cs" />
    <Compile Include="ConfigItemDeserialisationException.cs" />
    <Compile Include="HelpEntry.cs" />
    <Compile Include="Logger.cs" />
    <Compile Include="Server.cs" />
    <Compile Include="Commands\*.cs" />
    <Compile Include="Framework\FrameworkServerPacketDispatcher.cs" />
    <Compile Include="Framework\PhinixFrameworkServer.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Authentication.Server\Authentication.Server.csproj" />
    <ProjectReference Include="..\Common\Connections\Connections.csproj" />
    <ProjectReference Include="Connections.Server\Connections.Server.csproj" />
    <ProjectReference Include="..\Common\UserManagement\UserManagement.csproj" />
    <ProjectReference Include="UserManagement.Server\UserManagement.Server.csproj" />
    <ProjectReference Include="..\Common\Utils\Utils.csproj" />
    <ProjectReference Include="ServerRuntime\ServerRuntime.csproj" />
    <ProjectReference Include="..\Extensions\Chat\Server\ChatExtension.Server.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Extensions\Trade\Server\TradeExtension.Server.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Extensions\Chat\Contracts\ChatExtension.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Extensions\Trade\Contracts\TradeExtension.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <OfficialServerExtensionProject Include="..\Extensions\Chat\Server\ChatExtension.Server.csproj" />
    <OfficialServerExtensionProject Include="..\Extensions\Trade\Server\TradeExtension.Server.csproj" />
    <OfficialServerExtensionContractProject Include="..\Extensions\Chat\Contracts\ChatExtension.csproj" />
    <OfficialServerExtensionContractProject Include="..\Extensions\Trade\Contracts\TradeExtension.csproj" />
  </ItemGroup>

  <Target Name="CopyOfficialServerExtensions" AfterTargets="Build">
    <PropertyGroup>
      <_ExtensionsBase>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Extensions'))</_ExtensionsBase>
      <_ExtensionsConfigBin>bin\$(Configuration)\net10.0</_ExtensionsConfigBin>
      <_OfficialServerExtensionsOutputDir>$([System.IO.Path]::Combine('$(OutDir)', 'Extensions'))</_OfficialServerExtensionsOutputDir>
    </PropertyGroup>

    <ItemGroup>
      <_OfficialServerExtensionFile Include="$(_ExtensionsBase)\Chat\Server\$(_ExtensionsConfigBin)\ChatExtension.Server.dll" />
      <_OfficialServerExtensionFile Include="$(_ExtensionsBase)\Chat\Contracts\$(_ExtensionsConfigBin)\ChatExtension.dll" />
      <_OfficialServerExtensionFile Include="$(_ExtensionsBase)\Trade\Server\$(_ExtensionsConfigBin)\TradeExtension.Server.dll" />
      <_OfficialServerExtensionFile Include="$(_ExtensionsBase)\Trade\Contracts\$(_ExtensionsConfigBin)\TradeExtension.dll" />
      <_OfficialServerExtensionFile Include="$(OutDir)ChatExtension.Server.dll" />
      <_OfficialServerExtensionFile Include="$(OutDir)ChatExtension.dll" />
      <_OfficialServerExtensionFile Include="$(OutDir)TradeExtension.Server.dll" />
      <_OfficialServerExtensionFile Include="$(OutDir)TradeExtension.dll" />
    </ItemGroup>

    <ItemGroup>
      <_OfficialServerExtensionFileToCopy Include="@(_OfficialServerExtensionFile)" Condition="Exists('%(Identity)')" />
    </ItemGroup>

    <MakeDir Directories="$(_OfficialServerExtensionsOutputDir)" />
    <Copy
      SourceFiles="@(_OfficialServerExtensionFileToCopy)"
      DestinationFolder="$(_OfficialServerExtensionsOutputDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
